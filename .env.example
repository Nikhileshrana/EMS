# Capacitor (mobile/) — points the WebView at your Next.js origin
# Use your LAN IP for device testing (not localhost), e.g. http://192.168.1.10:3000
# Or your deployed URL, e.g. https://your-app.vercel.app
CAPACITOR_SERVER_URL=http://127.0.0.1:3000
