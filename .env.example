DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Required on Vercel (Production + Preview): all of the above.
# After deploy, set LiveKit webhook to: https://YOUR_DOMAIN/api/livekit/webhook

# Local Capacitor only (not needed on Vercel):
# CAPACITOR_SERVER_URL=https://your-app.vercel.app
CAPACITOR_SERVER_URL=http://127.0.0.1:3000
